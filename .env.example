# Required public Blob store base URL (must match the token's store)
# Format: https://<store-id>.public.blob.vercel-storage.com
NEXT_PUBLIC_BLOB_BASE_URL=
# Server-only token supplied when the Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=


# MongoDB connection
MONGODB_USR=
MONGODB_PWD=
MONGODB_URI=

# Auth - https://github.com/settings/applications (OAuth Apps)
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_URL=

# NEXTAUTH_SECRET can be generated using this command in linux:
# openssl rand -base64 32
NEXTAUTH_SECRET=
AUTHORIZED_EMAILS=your@email.something
